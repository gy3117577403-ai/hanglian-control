FROM node:22-alpine AS builder

WORKDIR /app

COPY package.json package-lock.json ./
COPY apps/api/package.json apps/api/package.json
COPY apps/tablet/package.json apps/tablet/package.json
RUN npm ci

COPY . .
RUN npm run build:tablet

FROM nginx:1.27-alpine AS tablet

ARG OCI_SOURCE="https://github.com/gy3117577403-ai/hanglian-control"
ARG OCI_REVISION="unknown"
ARG OCI_VERSION="dev"

LABEL org.opencontainers.image.source=$OCI_SOURCE
LABEL org.opencontainers.image.revision=$OCI_REVISION
LABEL org.opencontainers.image.version=$OCI_VERSION

COPY apps/tablet/docker/nginx.conf /etc/nginx/conf.d/default.conf
COPY apps/tablet/docker/entrypoint.sh /docker-entrypoint.d/40-hanglian-runtime-config.sh
RUN chmod +x /docker-entrypoint.d/40-hanglian-runtime-config.sh
COPY --from=builder /app/apps/tablet/dist /usr/share/nginx/html

ENV RUNTIME_API_BASE_URL=
ENV RUNTIME_APP_ENV=local
ENV RUNTIME_STORAGE_MODE=local

EXPOSE 80

HEALTHCHECK --interval=30s --timeout=3s --start-period=10s --retries=3 \
  CMD wget -qO- http://127.0.0.1/ >/dev/null || exit 1
