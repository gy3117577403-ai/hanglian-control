FROM node:22-alpine AS builder

WORKDIR /app

COPY package.json package-lock.json ./
COPY apps/api/package.json apps/api/package.json
COPY apps/tablet/package.json apps/tablet/package.json
RUN npm ci

COPY . .
RUN npm run build:tablet

FROM nginx:1.27-alpine AS tablet

COPY apps/tablet/nginx.conf /etc/nginx/conf.d/default.conf
COPY apps/tablet/docker-runtime-config.sh /docker-entrypoint.d/40-hanglian-runtime-config.sh
RUN chmod +x /docker-entrypoint.d/40-hanglian-runtime-config.sh
COPY --from=builder /app/apps/tablet/dist /usr/share/nginx/html

ENV API_BASE_URL=

EXPOSE 80
