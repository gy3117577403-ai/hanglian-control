NODE_ENV=development
HOST=0.0.0.0
PORT=3000
API_PREFIX=api
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
CORS_ALLOW_CREDENTIALS=false

# Local default: keep mock repositories.
DATA_SOURCE=mock
DEMO_DATA_MODE=empty
DEPLOYMENT_STAGE=readonly

# Sealos PostgreSQL test placeholder. Never commit real values.
# Prefer an isolated schema when using the default postgres database.
DB_TARGET=local
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=hanglian_control
DATABASE_SSL_MODE=require
DATABASE_CONNECT_TIMEOUT_SECONDS=10

# Safety flags.
ALLOW_TEST_DB_CONNECT=false
ALLOW_PRISMA_WRITE=false
ALLOW_DESTRUCTIVE_DB_ACTIONS=false

# Cloud deployment. Set true only for the isolated Sealos test database.
RUN_PRISMA_MIGRATE_DEPLOY=false

# Seed dry-run only. Do not use seed:test-db unless explicitly requested.
SEED_MODE=dry-run
SEED_OPERATOR_ID=system-seed
SEED_OPERATOR_NAME=system-seed

# File storage. Local is the only active default provider.
FILE_STORAGE_PROVIDER=local
STORAGE_ROOT=./storage
METADATA_ROOT=./storage/metadata
STORAGE_TEMP_ROOT=./storage/tmp
STORAGE_MAX_FILE_SIZE_MB=30
STORAGE_URL_MODE=proxy

# Optional S3/Object Storage placeholders. Keep empty until a real object store is selected.
S3_ENDPOINT=
S3_EXTERNAL_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true
S3_OBJECT_PREFIX=hanglian
S3_SIGNED_URL_TTL_SECONDS=900
