NODE_ENV=development
HOST=0.0.0.0
PORT=3000
API_PREFIX=api

# Local default: keep mock repositories.
DATA_SOURCE=mock
DEMO_DATA_MODE=empty
DEPLOYMENT_STAGE=readonly

# Sealos PostgreSQL test placeholder. Never commit real values.
# Prefer an isolated schema when using the default postgres database.
DB_TARGET=local
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=hanglian_control
DATABASE_SSL_MODE=require
DATABASE_CONNECT_TIMEOUT_SECONDS=10

# Safety flags.
ALLOW_TEST_DB_CONNECT=false
ALLOW_PRISMA_WRITE=false
ALLOW_DESTRUCTIVE_DB_ACTIONS=false

# Cloud deployment. Set true only for the isolated Sealos test database.
RUN_PRISMA_MIGRATE_DEPLOY=false

# Seed dry-run only. Do not use seed:test-db unless explicitly requested.
SEED_MODE=dry-run
SEED_OPERATOR_ID=system-seed
SEED_OPERATOR_NAME=system-seed
