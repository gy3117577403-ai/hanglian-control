NODE_ENV=development
PORT=3000
API_PREFIX=api

# V3.0A still keeps mock mode. Do not switch to prisma here.
DATA_SOURCE=mock
DEMO_DATA_MODE=empty

# Only Sealos PostgreSQL test database may use test target.
DB_TARGET=test

# Fill the real Sealos PostgreSQL test DATABASE_URL locally. Do not commit it.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public

# V3.0A allows read-only verification only.
ALLOW_TEST_DB_CONNECT=true

# V3.0A forbids database writes and destructive actions.
ALLOW_PRISMA_WRITE=false
ALLOW_DESTRUCTIVE_DB_ACTIONS=false

SEED_MODE=dry-run
SEED_OPERATOR_ID=system-seed
SEED_OPERATOR_NAME=系统初始化

DATABASE_SSL_MODE=require
DATABASE_CONNECT_TIMEOUT_SECONDS=10

# File storage. Local is the only active default provider.
FILE_STORAGE_PROVIDER=local
STORAGE_ROOT=./storage
METADATA_ROOT=./storage/metadata
STORAGE_TEMP_ROOT=./storage/tmp
STORAGE_MAX_FILE_SIZE_MB=30
STORAGE_URL_MODE=proxy

# Optional S3/Object Storage placeholders. Keep empty until a real object store is selected.
S3_ENDPOINT=
S3_EXTERNAL_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true
S3_OBJECT_PREFIX=hanglian
S3_SIGNED_URL_TTL_SECONDS=900
