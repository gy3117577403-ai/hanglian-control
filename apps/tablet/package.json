{
  "name": "tablet",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "lint": "echo \"tablet lint pending: V0.1 build-first\"",
    "preview": "vite preview",
    "build:android": "vue-tsc -b && vite build --mode android",
    "build:android:staging": "vue-tsc -b && vite build --mode android-staging",
    "build:android:release": "vue-tsc -b && vite build --mode android-release",
    "cap:sync:android": "cap sync android",
    "cap:sync:android:staging": "cap sync android",
    "cap:sync:android:release": "cap sync android",
    "cap:open:android": "cap open android",
    "android:assemble:debug": "node ../../scripts/android-gradle.mjs assembleDebug",
    "android:assemble:staging-debug": "node ../../scripts/android-gradle.mjs assembleStagingDebug",
    "android:assemble:production-release": "node ../../scripts/android-gradle.mjs assembleProductionRelease",
    "android:bundle:production-release": "node ../../scripts/android-gradle.mjs bundleProductionRelease"
  },
  "dependencies": {
